#!/usr/bin/env bash
# mailbox-fleet -- everything about the avatar mailbox fabric, from one place.
#
#   scripts/mailbox-fleet                     pick from a menu
#   scripts/mailbox-fleet status              what pass, the relay and each avatar hold
#   scripts/mailbox-fleet install [--check] [NAME...]
#                                             put the mailbox on avatars (default: all)
#   scripts/mailbox-fleet publish [--check]   install + address book + relay allowlist
#   scripts/mailbox-fleet rotate NAME...      mint NEW keys for these, then publish
#   scripts/mailbox-fleet relay-restart       load a changed allowlist
#
# One tool because it is one job. Installing the component, handing out the address
# book and pinning pubkeys in the relay allowlist are the same act seen from three
# places, and doing them from three scripts means typing avatar paths by hand into
# whichever one you remembered.
#
# Minting a key and syncing the relay allowlist were already one command each.
# The part that goes wrong by hand is the FAN-OUT: every avatar carries its OWN
# copy of the address book, so changing one identity means rewriting
# registry.json in every other avatar's directory and restarting every mailbox.
# Miss one and the failure is silent in the worst way -- that avatar cannot
# verify or address the rotated one, with no error until someone sends mail.
#
# There is an ordering hazard too, in mint-avatar-keys' own words: an avatar
# already published in registry.json and the allowlist must be RE-published or it
# will fail to start, because the container asserts the key it was given matches
# its registry entry. Minting without publishing leaves the fleet broken, so
# `rotate` always publishes.
#
# `publish` also INSTALLS the mailbox component into any avatar that lacks it, by
# calling nostr-mailbox/scripts/install. Copying files into one avatar is that
# script's job; knowing which avatars exist and where they live is this one's, and
# splitting them just means someone hand-runs a loop over the answer.
#
# MAINTAINER-run, host-side. Private keys live only in pass and are never printed
# -- this reads the public halves only.
#
# The avatar map is the same `name = directory` file harness-core's sync-fleet
# uses ($AGENT_FLEET_FILE, or --fleet FILE), so where avatars live is maintained
# once rather than in two places that drift.
set -euo pipefail

HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
RELAY_REPO="$(cd -- "$HERE/.." && pwd)"
MAILBOX_REPO="${MAILBOX_REPO:-$(cd -- "$RELAY_REPO/.." && pwd)/nostr-mailbox}"
PASS_PREFIX="${PASS_PREFIX:-nunet/avatars}"
FLEET_FILE="${AGENT_FLEET_FILE:-}"
CHECK=0

die() { printf '\033[1;31m[mailbox-fleet]\033[0m %s\n' "$*" >&2; exit 1; }
log() { printf '\033[1;34m[mailbox-fleet]\033[0m %s\n' "$*"; }
trim() { local s="$1"; s="${s#"${s%%[![:space:]]*}"}"; s="${s%"${s##*[![:space:]]}"}"; printf '%s' "$s"; }

CMD=""; declare -a ARGS=()
while (( $# )); do
    case "$1" in
        --check|--dry-run|-n) CHECK=1 ;;
        --fleet) shift; FLEET_FILE="${1:-}" ;;
        -h|--help) sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        -*) die "unknown option '$1' (--help)" ;;
        *) if [[ -z "$CMD" ]]; then CMD="$1"; else ARGS+=( "$1" ); fi ;;
    esac
    shift
done
CMD="${CMD:-menu}"

command -v pass >/dev/null || die "'pass' is not installed on this host"
[[ -x "$MAILBOX_REPO/scripts/build-registry" ]] || die "no build-registry at $MAILBOX_REPO (set MAILBOX_REPO)"
[[ -x "$MAILBOX_REPO/scripts/install" ]] || die "no install at $MAILBOX_REPO/scripts (set MAILBOX_REPO)"

# ------------------------------------------------------------------- fleet ---
declare -a NAMES=(); declare -A DIROF=()
load_fleet() {
    [[ -n "$FLEET_FILE" ]] || die "no avatar map: --fleet FILE, or set AGENT_FLEET_FILE (the same name=directory file sync-fleet reads)"
    [[ -f "$FLEET_FILE" ]] || die "no such fleet file: $FLEET_FILE"
    local line name dir
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%%#*}"; [[ -n "$(trim "$line")" ]] || continue
        [[ "$line" == *=* ]] || continue
        name="$(trim "${line%%=*}")"; dir="$(trim "${line#*=}")"; dir="${dir/#\~/$HOME}"
        NAMES+=( "$name" ); DIROF["$name"]="$dir"
    done < "$FLEET_FILE"
    (( ${#NAMES[@]} )) || die "$FLEET_FILE lists no avatars"
}

has_key()     { pass show "$PASS_PREFIX/$1/nostr-pubkey-hex" >/dev/null 2>&1; }
pubkey()      { pass show "$PASS_PREFIX/$1/nostr-pubkey-hex" 2>/dev/null | head -1; }
mailbox_dir() { printf '%s' "${DIROF[$1]}/tools/nostr-mailbox"; }

# The address book names every avatar that HAS an identity. One without a key is
# not addressable, so listing it would only invite a message that cannot be sent.
keyed_avatars() { local n; for n in "${NAMES[@]}"; do has_key "$n" && echo "$n"; done; return 0; }

# ----------------------------------------------------------------- publish ---
# The address book is built ONCE per run and the same file copied out. Generating
# it per avatar would let two copies differ if pass changed mid-run.
build_book() { # -> path of a temp file
    local -a keyed; mapfile -t keyed < <(keyed_avatars)
    (( ${#keyed[@]} )) || die "no avatar in $FLEET_FILE has a key in pass -- mint first"
    local tmp; tmp="$(mktemp)"
    "$MAILBOX_REPO/scripts/build-registry" "${keyed[@]}" > "$tmp" || die "build-registry failed"
    log "address book covers ${#keyed[@]} avatar(s): ${keyed[*]}" >&2
    printf '%s' "$tmp"
}

give_book() { # <book> <avatar>...
    local book="$1"; shift
    local n mdir
    for n in "$@"; do
        mdir="$(mailbox_dir "$n")"
        if [[ ! -d "$mdir" ]]; then
            printf '  %-32s no component here -- install first\n' "$n"
        elif cmp -s "$book" "$mdir/registry.json"; then
            printf '  %-32s address book already current\n' "$n"
        elif (( CHECK )); then
            printf '  %-32s address book WOULD be updated\n' "$n"
        else
            cp "$book" "$mdir/registry.json"
            printf '  %-32s address book updated\n' "$n"
        fi
    done
}

sync_allowlist() {
    local -a keyed; mapfile -t keyed < <(keyed_avatars)
    if (( CHECK )); then
        log "--check: the relay allowlist would be synced for ${#keyed[@]} avatar(s); nothing written"
    else
        log "syncing the relay allowlist"
        "$RELAY_REPO/scripts/sync-allowlist" "${keyed[@]}"
        echo ""
        echo "  To load it (config.toml is read only at relay start):"
        echo "    cd $RELAY_REPO && docker compose restart nostr-relay"
    fi
}

# publish = the whole fleet, every step. The menu does the same things per avatar.
publish() {
    local book; book="$(build_book)"
    echo ""
    install_avatars ${NAMES[@]+"${NAMES[@]}"}
    give_book "$book" ${NAMES[@]+"${NAMES[@]}"}
    rm -f "$book"
    echo ""
    sync_allowlist
}

# ----------------------------------------------------------------- install ---
# Put (or refresh) the component on avatars. install does the per-avatar copying;
# knowing which avatars exist and where they live is this script's job.
install_avatars() {
    local n dir rc=0
    for n in "$@"; do
        dir="${DIROF[$n]:-}"
        [[ -n "$dir" ]] || { printf '  %-32s not in %s\n' "$n" "$FLEET_FILE"; rc=1; continue; }
        if (( CHECK )); then
            printf '  %-32s WOULD install/refresh\n' "$n"; continue
        fi
        if "$MAILBOX_REPO/scripts/install" "$dir" --no-registry >/dev/null; then
            printf '  %-32s component installed/refreshed\n' "$n"
        else
            printf '  %-32s INSTALL FAILED\n' "$n"; rc=1
        fi
    done
    return $rc
}

relay_restart() {
    log "restarting the relay (config.toml is read only at start)"
    ( cd "$RELAY_REPO" && docker compose restart nostr-relay )
}

# ------------------------------------------------------------------ rotate ---
rotate() {
    (( ${#ARGS[@]} )) || die "rotate needs at least one avatar name"
    (( CHECK )) && die "rotate cannot be dry-run -- minting is what it does. Use 'publish --check' to preview the fan-out."
    local n
    for n in "${ARGS[@]}"; do
        [[ -n "${DIROF[$n]:-}" ]] || die "'$n' is not in $FLEET_FILE"
    done
    log "MINTING NEW KEYS for: ${ARGS[*]}"
    log "each previous key stops being accepted the moment the allowlist is synced"
    "$MAILBOX_REPO/scripts/mint-avatar-keys" "${ARGS[@]}" || die "mint-avatar-keys failed"
    echo ""
    # Always publish: a minted-but-unpublished avatar fails to start, because the
    # container asserts its injected key matches its registry entry.
    publish
}

# ------------------------------------------------------------------ status ---
status() {
    # Honour CONF exactly as sync-allowlist does, or status reports on a
    # different file from the one publish writes.
    local conf; conf="${CONF:-$RELAY_REPO/config.toml}"
    local allow; allow="$(cat "$conf" 2>/dev/null || true)"
    local tmp; tmp="$(mktemp)"; trap 'rm -f "$tmp"' RETURN
    local -a keyed; mapfile -t keyed < <(keyed_avatars)
    if (( ${#keyed[@]} )); then
        "$MAILBOX_REPO/scripts/build-registry" "${keyed[@]}" > "$tmp" 2>/dev/null || true
    fi

    printf '\n  fleet map: %s\n  relay:     %s\n  pass:      %s/<avatar>/\n\n' "$FLEET_FILE" "$conf" "$PASS_PREFIX"
    printf '  %-32s %-9s %-10s %-9s %s\n' "avatar" "key" "in relay" "mailbox" "registry.json"
    local n hex mdir
    for n in "${NAMES[@]}"; do
        hex=""; has_key "$n" && hex="$(pubkey "$n")"
        mdir="$(mailbox_dir "$n")"
        printf '  %-32s %-9s %-10s %-9s %s\n' "$n" \
            "$( [[ -n "$hex" ]] && echo yes || echo MISSING )" \
            "$( [[ -n "$hex" && "$allow" == *"$hex"* ]] && echo yes || echo no )" \
            "$( [[ -d "$mdir" ]] && echo yes || echo no )" \
            "$( if [[ ! -d "$mdir" ]]; then echo "-"; elif cmp -s "$tmp" "$mdir/registry.json"; then echo current; else echo STALE; fi )"
    done
    printf '\n  a STALE registry, or a no under "in relay", is fixed by:  scripts/mailbox-fleet publish\n\n'
}


# -------------------------------------------------------------------- menu ---
# Same shape as harness-core's sync-fleet: the listing IS the status, so choosing
# what to do and seeing what needs doing are one screen rather than two commands.
menu() {
    local conf tmp allow n hex mdir i reply
    while true; do
        conf="${CONF:-$RELAY_REPO/config.toml}"
        allow="$(cat "$conf" 2>/dev/null || true)"
        tmp="$(mktemp)"
        local -a keyed; mapfile -t keyed < <(keyed_avatars)
        (( ${#keyed[@]} )) && "$MAILBOX_REPO/scripts/build-registry" "${keyed[@]}" > "$tmp" 2>/dev/null || true

        echo ""
        echo "  Mailbox fleet   fleet: $FLEET_FILE"
        echo "                  relay: $conf"
        printf '                  --check: %s\n' "$( ((CHECK)) && echo on || echo off )"
        echo ""
        printf '    %-3s %-32s %-5s %-10s %-9s %s\n' "#" "avatar" "key" "component" "in relay" "address book"
        i=1
        for n in ${NAMES[@]+"${NAMES[@]}"}; do
            hex=""; has_key "$n" && hex="$(pubkey "$n")"
            mdir="$(mailbox_dir "$n")"
            printf '    %-3s %-32s %-5s %-10s %-9s %s\n' "$i)" "$n" \
                "$( [[ -n "$hex" ]] && echo yes || echo NO )" \
                "$( [[ -x "$mdir/mailbox" ]] && echo yes || echo no )" \
                "$( [[ -n "$hex" && "$allow" == *"$hex"* ]] && echo yes || echo no )" \
                "$( if [[ ! -d "$mdir" ]]; then echo "-"; elif cmp -s "$tmp" "$mdir/registry.json"; then echo current; else echo STALE; fi )"
            i=$((i+1))
        done
        rm -f "$tmp"
        echo ""
        echo "    numbers (e.g. 1 3) or a) all  -- choose avatars, then what to do to them"
        echo "    s) sync the relay allowlist   x) restart the relay"
        echo "    c) toggle --check             q) quit"
        echo ""
        printf "  Avatars: "
        read -r reply || return 0
        local -a sel=()
        case "$reply" in
            q|Q|"") return 0 ;;
            c|C) CHECK=$((1-CHECK)); continue ;;
            s|S) sync_allowlist; continue ;;
            x|X) relay_restart; continue ;;
            a|A) sel=( ${NAMES[@]+"${NAMES[@]}"} ) ;;
            *)
                local tok
                for tok in $reply; do
                    [[ "$tok" =~ ^[0-9]+$ ]] || { echo "  not a number: $tok"; sel=(); break; }
                    (( tok >= 1 && tok <= ${#NAMES[@]} )) || { echo "  out of range: $tok"; sel=(); break; }
                    sel+=( "${NAMES[$((tok-1))]}" )
                done ;;
        esac
        (( ${#sel[@]} )) || continue
        act_on "${sel[@]}"
    done
}

# What to do to the chosen avatars. Separating selection from action is the point:
# an avatar is set up, or re-synced, or rotated, on its own -- not as a side effect
# of an operation aimed at the whole fleet.
act_on() {
    local -a sel=( "$@" )
    local reply book
    while true; do
        echo ""
        printf '  Selected: %s\n' "${sel[*]}"
        echo ""
        echo "    f) full setup -- install the component and give it the address book"
        echo "    i) install / refresh the component only"
        echo "    b) give the current address book only"
        echo "    k) rotate keys (MINTS NEW ONES, and republishes the fleet)"
        echo "    <enter>) back"
        echo ""
        printf "  Do what: "
        read -r reply || return 0
        case "$reply" in
            ""|b*ack) return 0 ;;
            i|I) echo ""; install_avatars "${sel[@]}" || true; return 0 ;;
            b|B) echo ""; book="$(build_book)"; give_book "$book" "${sel[@]}"; rm -f "$book"; return 0 ;;
            f|F) echo ""; install_avatars "${sel[@]}" || true
                 book="$(build_book)"; give_book "$book" "${sel[@]}"; rm -f "$book"; return 0 ;;
            k|K)
                printf "  This REPLACES the identity of: %s\n" "${sel[*]}"
                printf "  Every other avatar's address book changes with it. Type ROTATE: "
                read -r reply || return 0
                [[ "$reply" == "ROTATE" ]] || { echo "  cancelled"; return 0; }
                ARGS=( "${sel[@]}" ); rotate; return 0 ;;
            *) echo "  not an option: $reply" ;;
        esac
    done
}

load_fleet
case "$CMD" in
    menu)          menu ;;
    status)        status ;;
    install)       (( ${#ARGS[@]} )) && install_avatars "${ARGS[@]}" \
                       || install_avatars ${NAMES[@]+"${NAMES[@]}"} ;;
    publish)       publish ;;
    rotate)        rotate ;;
    relay-restart) relay_restart ;;
    *) die "unknown command '$CMD' (menu|status|install|publish|rotate|relay-restart)" ;;
esac
