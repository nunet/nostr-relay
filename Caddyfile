# TLS for the gated relay. Websocket upgrades pass through reverse_proxy as-is.
# The certificate comes over 443 only (TLS-ALPN-01): port 80 is not published by
# docker-compose.public.yml, so the HTTP-01 challenge is switched off rather than tried and failed.
{$RELAY_DOMAIN} {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}
	# deployed.json: what the deploy workflow last marked healthy (shields.io endpoint JSON, read by
	# the README badge). Written by the deploy into the directory mounted at /srv/deploy.
	handle /deployed.json {
		root * /srv/deploy
		file_server
	}
	# the omega hive (omega-flagship/omegahive-deploy), on the shared network omegahive-proxy. The hive serves
	# itself under /omegahive (HIVE_BASE_PATH), so the prefix is passed on, not stripped.
	@omegahive path /omegahive /omegahive/*
	handle @omegahive {
		reverse_proxy omegahive:8700
	}
	handle {
		reverse_proxy nostr-relay:8080
	}
}
